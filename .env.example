# Copy this file to .env.local and fill in real values.
# Used by app/api/enquiry/route.js (via lib/email/enquiry-email.js) to email
# enquiries to MAIL_TO via Resend. See EMAIL_SETUP.md for the full setup,
# testing, and deployment guide.
RESEND_API_KEY=your-resend-api-key
MAIL_TO=connectmytours@gmail.com

# Supabase (used by /admin — Auth, database, RLS). Safe to expose to the browser:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — NEVER prefix with NEXT_PUBLIC_, never stored in the database.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
