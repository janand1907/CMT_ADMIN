# Copy this file to .env.local and fill in real values.
# Used by app/api/enquiry/route.js (via lib/email/enquiry-email.js) to email
# enquiries to MAIL_TO via Resend. See EMAIL_SETUP.md for the full setup,
# testing, and deployment guide.
RESEND_API_KEY=your-resend-api-key
MAIL_TO=connectmytours@gmail.com

# Supabase (used by /admin — Auth, database, RLS). Safe to expose to the browser:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — NEVER prefix with NEXT_PUBLIC_, never stored in the database.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Cloud API (Phase 4 — see lib/whatsapp/provider.js and /admin/settings/whatsapp).
# Server-side only. Real values come from the Meta developer app once the staging
# WhatsApp test number/webhook setup is complete — do not fill in real values here.
# WHATSAPP_CLOUD_API_TOKEN=your-cloud-api-access-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_APP_SECRET=your-meta-app-secret
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-your-own-verify-token

# Shared secret the Hostinger Cron job presents as "Authorization: Bearer $CRON_SECRET"
# when it calls /api/cron/whatsapp-followup. Server-side only.
# CRON_SECRET=your-own-random-secret
